# Copy to .env for direct model calls with code/run_arms.py and the screening scripts.
# The default (offline) reproduction needs none of these.
#
# Keys are read in-process. Never pass them on a command line: shell history and
# logs can record command echoes.

# M1: proprietary annotator (gpt-5.6-luna)
OPENAI_API_KEY=

# M2: open-weight annotator (qwen3-32b, via DashScope)
DASHSCOPE_API_KEY=

# Screening scripts
DEEPSEEK_API_KEY=
